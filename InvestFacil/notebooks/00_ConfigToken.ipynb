    "%python\n",
    "# Criar o secret scope (só precisa fazer uma vez)\n",
    "# Substitua SEU_TOKEN pelo token copiado do GitHub\n",
    "\n",
    "from databricks.sdk import WorkspaceClient\n",
    "\n",
    "w = WorkspaceClient()\n",
    "w.secrets.put_secret(scope=\"investfacil\", key=\"github_token\", string_value=\"SEU_TOKEN_AQUI\")"
   ]
