    "%sql\n",
    "USE CATALOG dbacademy;\n",
    "USE SCHEMA get_started_de;\n",
    "\n",
    "CREATE OR REFRESH MATERIALIZED VIEW employes_gold_sdp\n",
    "COMMENT 'fazendo cout do Roles lendo a view da tabela employes_silver_sdp'\n",
    "AS SELECT\n",
    "Role,\n",
    "count(1) as TotalEmployes\n",
    "FROM employes_silver_sdp\n",
    "GROUP BY \n",
    "Role;"
